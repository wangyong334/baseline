ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.3/bin/nvcc

cflags = -pthread -B /home/a/anaconda3/envs/ev-uav/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/a/anaconda3/envs/ev-uav/include -I/home/a/anaconda3/envs/ev-uav/include -fPIC -O2 -isystem /home/a/anaconda3/envs/ev-uav/include -fPIC -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/TH -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.3/include -I/home/a/anaconda3/envs/ev-uav/include/python3.9 -c
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=HAIS_OP -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
cuda_cflags = -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/TH -I/home/a/anaconda3/envs/ev-uav/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.3/include -I/home/a/anaconda3/envs/ev-uav/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=HAIS_OP -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



build /home/a/chennuo/EV-UAV-main/lib/hais_ops/build/temp.linux-x86_64-cpython-39/src/cuda.o: cuda_compile /home/a/chennuo/EV-UAV-main/lib/hais_ops/src/cuda.cu
build /home/a/chennuo/EV-UAV-main/lib/hais_ops/build/temp.linux-x86_64-cpython-39/src/hais_ops.o: compile /home/a/chennuo/EV-UAV-main/lib/hais_ops/src/hais_ops.cpp
build /home/a/chennuo/EV-UAV-main/lib/hais_ops/build/temp.linux-x86_64-cpython-39/src/hais_ops_api.o: compile /home/a/chennuo/EV-UAV-main/lib/hais_ops/src/hais_ops_api.cpp





